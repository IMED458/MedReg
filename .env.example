# ==============================================================================
# სამედიცინო რეგულირების ქეისების მართვის სისტემა — გარემოს ცვლადების შაბლონი
# ==============================================================================
# MVP ეტაპზე სისტემა მუშაობს ლოკალურად IndexedDB-ზე (Dexie).
# Firebase Auth, Cloud Firestore და გარე ფაილსაცავის ჩასართავად შეავსეთ ქვედა პარამეტრები.

# რეჟიმი: local | firebase
VITE_STORAGE_MODE="local"

# Firebase კლიენტის კონფიგურაცია (საჯარო კლიენტის გასაღებები)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# ფაილსაცავის პროვაიდერი: indexeddb | firebase_storage | s3_b2_proxy
VITE_FILE_STORAGE_PROVIDER="indexeddb"

# მომავალი სერვერული Cloud Storage / Backblaze B2 პროქსი (მხოლოდ სერვერზე, არა VITE_)
STORAGE_ENDPOINT=""
STORAGE_BUCKET_NAME=""
STORAGE_KEY_ID=""
STORAGE_APPLICATION_KEY=""

# მომავალი SMS / Email შეტყობინებების პროვაიდერი (მხოლოდ სერვერზე)
NOTIFICATION_EMAIL_API_KEY=""
NOTIFICATION_SMS_API_KEY=""
APP_URL="MY_APP_URL"
