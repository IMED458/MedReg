rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function active() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && profile().isActive == true;
    }

    function roleIn(roles) {
      return active() && profile().role in roles;
    }

    function editor() {
      return roleIn(['admin', 'supervisor', 'inspector']);
    }

    function admin() {
      return roleIn(['admin']);
    }

    function initialAdminBootstrap(uid) {
      return signedIn()
        && request.auth.uid == uid
        && request.auth.token.email == 'imedo@medreg.local'
        && !exists(/databases/$(database)/documents/users/$(uid))
        && request.resource.data.id == uid
        && request.resource.data.username == 'imedo'
        && request.resource.data.role == 'admin'
        && request.resource.data.isActive == true;
    }

    match /users/{uid} {
      allow read: if active();
      allow create: if admin() || initialAdminBootstrap(uid);
      allow update: if admin() || (
        active()
        && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.isActive == resource.data.isActive
        && request.resource.data.username == resource.data.username
      );
      allow delete: if admin() && request.auth.uid != uid;
    }

    match /settings/{documentId} {
      allow read: if active();
      allow write: if admin();
    }

    match /counters/{documentId} {
      allow read: if active();
      allow create, update: if editor();
      allow delete: if admin();
    }

    match /activity_logs/{logId} {
      allow read: if active();
      allow create: if active() && (request.resource.data.performedBy == request.auth.uid || admin());
      allow update, delete: if false;
    }

    match /{collectionName}/{documentId} {
      allow read: if active() && collectionName in [
        'cases', 'case_participants', 'persons', 'applicants', 'patients',
        'organizations', 'case_organizations', 'doctors', 'case_doctors',
        'visits', 'inspection_acts', 'orders', 'commissions', 'case_commissions',
        'document_requests', 'evidence_transfers', 'correspondence', 'reviewers',
        'review_assignments', 'tasks', 'reminders', 'attachments', 'comments',
        'custom_field_values', 'case_links'
      ];
      allow create, update: if editor() && collectionName in [
        'cases', 'case_participants', 'persons', 'applicants', 'patients',
        'organizations', 'case_organizations', 'doctors', 'case_doctors',
        'visits', 'inspection_acts', 'orders', 'commissions', 'case_commissions',
        'document_requests', 'evidence_transfers', 'correspondence', 'reviewers',
        'review_assignments', 'tasks', 'reminders', 'attachments', 'comments',
        'custom_field_values', 'case_links'
      ];
      allow delete: if admin() && collectionName in [
        'cases', 'case_participants', 'persons', 'applicants', 'patients',
        'organizations', 'case_organizations', 'doctors', 'case_doctors',
        'visits', 'inspection_acts', 'orders', 'commissions', 'case_commissions',
        'document_requests', 'evidence_transfers', 'correspondence', 'reviewers',
        'review_assignments', 'tasks', 'reminders', 'attachments', 'comments',
        'custom_field_values', 'case_links'
      ];
    }
  }
}
